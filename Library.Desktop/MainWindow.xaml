<ui:FluentWindow x:Class="Library.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:Library.Desktop.ViewModels"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Library.Desktop.Controls"
                 xmlns:models="clr-namespace:Library.Desktop.Models"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DesignMainViewModel, IsDesignTimeCreatable=True}"
                 Title="收藏庫" Height="800" Width="1320"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="收藏庫" />
        <DockPanel Margin="12,4,12,12">
            <!-- 工具列：動作在左，狀態在右 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="新增作品" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                               Command="{Binding NewCommand}" />
                    <ui:Button Content="重新載入" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                               Command="{Binding LoadCommand}" />
                    <ui:Button Content="管理類型" Icon="{ui:SymbolIcon Settings24}" Margin="8,0,0,0"
                               Command="{Binding ManageWorkTypesCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- 搜尋、篩選、排序；視窗窄時自動換行 -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280"
                            PlaceholderText="搜尋名稱、作者、系列、備註" Icon="{ui:SymbolIcon Search24}"
                            Margin="0,0,6,4">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Content="搜尋" Command="{Binding LoadCommand}" Margin="0,0,16,4" />

                <ComboBox ItemsSource="{Binding WorkTypeFilters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding FilterWorkTypeId}" Width="130" Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding ScoreFilters}" SelectedItem="{Binding SelectedScoreFilter}"
                          DisplayMemberPath="Label" Width="130" Margin="0,0,8,4" />
                <CheckBox Content="只看最愛" IsChecked="{Binding OnlyFavorite}" Margin="0,0,16,4" />
                <CheckBox Content="DLC 沒買齊" IsChecked="{Binding DlcUnbought}" Margin="0,0,16,4" />

                <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Label" Width="130" Margin="0,0,8,4" />
                <CheckBox Content="降冪" IsChecked="{Binding SortDescending}" Margin="0,0,0,4" />
            </WrapPanel>

            <!-- 標籤篩選：預設收合，標題顯示已選幾個；標籤多時限制高度、內部捲動，不把表格往下擠 -->
            <Expander DockPanel.Dock="Top" Header="{Binding TagFilterHeader}" Margin="0,0,0,8">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Top" Content="符合任一個即可（不勾：全部都要有）"
                              IsChecked="{Binding TagMatchAny}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagFilterOption}">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                              MinWidth="0" Margin="0,0,16,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Expander>

            <!-- 右側：編輯表單。儲存、刪除固定在底部，表單本身比視窗高時可捲動 -->
            <DockPanel x:Name="EditForm" DockPanel.Dock="Right" Width="320" Margin="12,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="儲存" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                                   HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
                        <ui:Button Grid.Column="2" Content="刪除" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                   HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="FormScroll_ScrollChanged">
                    <StackPanel Margin="0,0,12,0">
                        <!-- 從商店抓資料：只填表單，不存檔 -->
                        <TextBlock Text="從商店網址抓取" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="抓取" Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Margin="6,0,0,0" Command="{Binding FetchCommand}" />
                            <ui:TextBox Text="{Binding StoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="貼上 Steam 商品頁網址">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </DockPanel>
                        <Separator Margin="0,12,0,0" />

                        <!-- 封面：可拖放圖片到框裡；剪貼簿裡是圖片時按 Ctrl+V 貼上 -->
                        <TextBlock Text="封面" Style="{StaticResource SectionHeader}" />
                        <Border AllowDrop="True" DragOver="CoverArea_DragOver" Drop="CoverArea_Drop"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6" Height="200">
                            <Grid>
                                <!-- 沒有指定 Row、Column，三個元素疊在同一格：預覽、提示、進度圈 -->
                                <Image Source="{Binding CoverPreviewUrl}" Stretch="Uniform" Margin="4" />

                                <!-- 沒有封面時才顯示提示 -->
                                <TextBlock Text="拖放圖片到這裡&#10;或按 Ctrl+V 貼上" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverPreviewUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ui:ProgressRing IsIndeterminate="True"
                                                 Visibility="{Binding IsCoverBusy, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="選擇圖片" Icon="{ui:SymbolIcon ImageAdd24}"
                                       HorizontalAlignment="Stretch" Command="{Binding PickCoverCommand}" />
                            <ui:Button Grid.Column="2" Content="移除" Icon="{ui:SymbolIcon Dismiss24}"
                                       HorizontalAlignment="Stretch" Command="{Binding RemoveCoverCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding CoverStatus}" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                        <Separator Margin="0,12,0,0" />

                        <TextBlock Text="名稱" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="中文" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TitleZh, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="日文" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TitleJa, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="英文" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TitleEn, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="創作者" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="作者／開發人員" Style="{StaticResource FieldLabel}" />
                        <controls:NameListInput DataContext="{Binding Authors}" Margin="0,0,0,8" />
                        <TextBlock Text="社團／發行商" Style="{StaticResource FieldLabel}" />
                        <controls:NameListInput DataContext="{Binding Circles}" />

                        <TextBlock Text="分類" Style="{StaticResource SectionHeader}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="類型" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding WorkTypes}" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" SelectedValue="{Binding WorkTypeId}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="上架日期" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding ReleaseDate}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="系列" Style="{StaticResource FieldLabel}" />
                        <!-- 可直接輸入新系列（存檔時由 API 建立），也可以從建議選；目前作者的系列排前面 -->
                        <ui:AutoSuggestBox
                            Text="{Binding SeriesInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding SeriesSuggestions}"
                            UpdateTextOnSelect="False"
                            TextChanged="SeriesBox_TextChanged"
                            SuggestionChosen="SeriesBox_SuggestionChosen"
                            Margin="0,0,0,8">
                            <ui:AutoSuggestBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SeriesItem}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ui:AutoSuggestBox.ItemTemplate>
                        </ui:AutoSuggestBox>
                        <TextBlock Text="標籤" Style="{StaticResource FieldLabel}" />
                        <controls:NameListInput DataContext="{Binding Tags}" />

                        <TextBlock Text="評價" Style="{StaticResource SectionHeader}" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="最愛" IsChecked="{Binding Favorite}"
                                      MinWidth="0" Margin="12,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="評分（6 是王冠）" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Score}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="商店網址" Style="{StaticResource SectionHeader}" />
                        <!-- 每一列的 DataContext 是 UrlRow；選項和命令在 MainViewModel，要經 RelativeSource 往上取 -->
                        <ItemsControl ItemsSource="{Binding Urls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UrlRow}">
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                                                           ToolTip="移除這個網址" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.RemoveUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="https://…" />
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <ComboBox
                                                    ItemsSource="{Binding DataContext.UrlLanguageOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    DisplayMemberPath="Label" SelectedValuePath="Value"
                                                    SelectedValue="{Binding Language}" Width="100" Margin="0,0,12,0" />
                                                <CheckBox Content="已購買" IsChecked="{Binding Purchased}" MinWidth="0" />
                                            </StackPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <!-- 清單順序就是存檔的順序，第一個是主要網址 -->
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowDown24}"
                                                           ToolTip="往下移" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.MoveUrlDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUp24}"
                                                           ToolTip="往上移" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.MoveUrlUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="價格" Width="96" />
                                                    <ui:TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="幣別" Width="72" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="新增網址" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Stretch"
                                   Command="{Binding AddUrlCommand}" />
                        <TextBlock Text="DLC／追加內容" Style="{StaticResource SectionHeader}" />
                        <!-- 結構同網址卡片；名稱必填，網址可省略，沒有語言 -->
                        <ItemsControl ItemsSource="{Binding Dlcs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DlcRow}">
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                                                           ToolTip="移除這個 DLC" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.RemoveDlcCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="名稱" />
                                            </DockPanel>
                                            <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="網址（可省略）"
                                                        Margin="0,6,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <CheckBox Content="已購買" IsChecked="{Binding Purchased}" MinWidth="0" />
                                            </StackPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowDown24}"
                                                           ToolTip="往下移" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.MoveDlcDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUp24}"
                                                           ToolTip="往上移" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.MoveDlcUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="價格" Width="96" />
                                                    <ui:TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="幣別" Width="72" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="新增 DLC" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Stretch"
                                   Command="{Binding AddDlcCommand}" />
                        <TextBlock Text="備註" Style="{StaticResource SectionHeader}" />
                        <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Height="72" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- 作品表格放最後，填滿剩下的空間 -->
            <!-- 唯讀清單用 ListView + GridView：DataGrid 每格多好幾層元件，換排序時排版繪製慢一倍以上 -->
            <!-- 要用 ui: 版本：GridView 自己指定樣式，不會套用 App.xaml 的主題 -->
            <ui:ListView ItemsSource="{Binding Works}" SelectedItem="{Binding SelectedWork}">
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn Header="作品名" DisplayMemberBinding="{Binding Title}" Width="220" />
                        <ui:GridViewColumn Header="作者" DisplayMemberBinding="{Binding AuthorsText}" Width="120" />
                        <ui:GridViewColumn Header="社團" DisplayMemberBinding="{Binding CirclesText}" Width="120" />
                        <ui:GridViewColumn Header="類型" DisplayMemberBinding="{Binding WorkType}" Width="64" />
                        <ui:GridViewColumn Header="系列" DisplayMemberBinding="{Binding Series}" Width="100" />
                        <ui:GridViewColumn Header="標籤" DisplayMemberBinding="{Binding TagsText}" Width="120" />
                        <ui:GridViewColumn Header="評分" DisplayMemberBinding="{Binding ScoreText}" Width="80" />
                        <ui:GridViewColumn Header="最愛" DisplayMemberBinding="{Binding FavoriteText}" Width="56" />
                        <ui:GridViewColumn Header="已購買" DisplayMemberBinding="{Binding PurchasedText}" Width="64" />
                        <ui:GridViewColumn Header="上架日"
                                           DisplayMemberBinding="{Binding ReleaseDate, StringFormat=yyyy/MM/dd}"
                                           Width="96" />
                        <ui:GridViewColumn Header="修改時間"
                                           DisplayMemberBinding="{Binding UpdatedAtLocal, StringFormat=yyyy/MM/dd HH:mm}"
                                           Width="130" />
                        <ui:GridViewColumn Header="加入時間"
                                           DisplayMemberBinding="{Binding CreatedAtLocal, StringFormat=yyyy/MM/dd HH:mm}"
                                           Width="130" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
