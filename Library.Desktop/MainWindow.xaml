<ui:FluentWindow x:Class="Library.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:Library.Desktop.ViewModels"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="收藏庫" Height="700" Width="1200"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="收藏庫" />
        <DockPanel Margin="8">
            <!-- 工具列 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="重新載入" Command="{Binding LoadCommand}" Padding="12,4" />
                <Button Content="新增" Command="{Binding NewCommand}" Padding="12,4" Margin="8,0,0,0" />
                <Button Content="管理類型" Command="{Binding ManageWorkTypesCommand}" Padding="12,4" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- 搜尋、篩選、排序 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="搜尋" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="搜尋" Command="{Binding LoadCommand}" Padding="12,2" Margin="6,0,16,0" />

                <CheckBox Content="只看最愛" IsChecked="{Binding OnlyFavorite}" VerticalAlignment="Center"
                          Margin="0,0,16,0" />

                <ComboBox ItemsSource="{Binding WorkTypeFilters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding FilterWorkTypeId}" Width="100" Margin="0,0,16,0" />
                <ComboBox ItemsSource="{Binding ScoreFilters}" SelectedItem="{Binding SelectedScoreFilter}"
                          DisplayMemberPath="Label" Width="100" Margin="0,0,16,0" />

                <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Label" Width="90" />
                <CheckBox Content="降冪" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- 標籤篩選：DataType 讓 Rider 檢查樣板內的繫結名稱 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="標籤" Margin="0,0,6,0" />
                <CheckBox DockPanel.Dock="Right" Content="符合任一" IsChecked="{Binding TagMatchAny}" />
                <ItemsControl ItemsSource="{Binding TagFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TagFilterOption}">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,12,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <!-- 右側：編輯表單，比視窗高時可捲動 -->
            <ScrollViewer DockPanel.Dock="Right" Width="260" Margin="8,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="商店網址" />
                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="抓取" Command="{Binding FetchCommand}"
                                Padding="10,0" Margin="4,0,0,0" />
                        <TextBox Text="{Binding StoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <!-- 上面是「從商店抓資料」，下面才是要存的表單 -->
                    <Separator Margin="0,0,0,8" />
                    <TextBlock Text="網址" />
                    <!-- 每一列的 DataContext 是 UrlRow；選項和命令在 MainViewModel，要經 RelativeSource 往上取 -->
                    <ItemsControl ItemsSource="{Binding Urls}" Margin="0,2,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UrlRow}">
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ComboBox
                                            ItemsSource="{Binding DataContext.UrlLanguageOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            DisplayMemberPath="Label" SelectedValuePath="Value"
                                            SelectedValue="{Binding Language}" Width="90" Margin="0,0,8,0" />
                                        <CheckBox Content="已購買" IsChecked="{Binding Purchased}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Margin="4,0,0,0" />
                                        <Button Content="▲" Margin="8,0,0,0"
                                                Command="{Binding DataContext.MoveUrlUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="▼" Margin="4,0,0,0"
                                                Command="{Binding DataContext.MoveUrlDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="新增網址" Command="{Binding AddUrlCommand}" Margin="0,0,0,8" />
                    <TextBlock Text="中文名稱" />
                    <TextBox Text="{Binding TitleZh, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="日文名稱" />
                    <TextBox Text="{Binding TitleJa, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="英文名稱" />
                    <TextBox Text="{Binding TitleEn, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <!-- 不加 TextWrapping：長名字自動折行會看起來像兩個名字 -->
                    <TextBlock Text="作者/開發人員 (一行一個)" />
                    <TextBox Text="{Binding AuthorsInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" />
                    <TextBlock Text="社團/發行商 (一行一個)" />
                    <TextBox Text="{Binding CirclesInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" />
                    <TextBlock Text="類型" />
                    <ComboBox ItemsSource="{Binding WorkTypes}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding WorkTypeId}" Margin="0,2,0,8" />
                    <!-- 可直接輸入新系列（存檔時由 API 建立），也可以從清單選 -->
                    <TextBlock Text="系列" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding SeriesOptions}"
                              DisplayMemberPath="Name"
                              Text="{Binding SeriesInput, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,2,0,8"
                              StaysOpenOnEdit="True" />
                    <TextBlock Text="標籤 (一行一個)" />
                    <TextBox Text="{Binding TagsInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" />
                    <TextBlock Text="評分（6 是王冠）" />
                    <ComboBox ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Score}" Margin="0,2,0,8" />
                    <CheckBox Content="最愛" IsChecked="{Binding Favorite}" Margin="0,0,0,4" />
                    <TextBlock Text="上架日期" />
                    <DatePicker SelectedDate="{Binding ReleaseDate}" Margin="0,2,0,8" />
                    <TextBlock Text="備註" />
                    <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8" />
                    <Button Content="儲存" Command="{Binding SaveCommand}" Padding="12,4" />
                    <Button Content="刪除" Command="{Binding DeleteCommand}" Padding="12,4" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
            <!-- 作品表格放最後，填滿剩下的空間 -->
            <!-- 唯讀清單用 ListView + GridView：DataGrid 每格多好幾層元件，換排序時排版繪製慢一倍以上 -->
            <!-- 要用 ui: 版本：GridView 自己指定樣式，不會套用 App.xaml 的主題 -->
            <ui:ListView ItemsSource="{Binding Works}" SelectedItem="{Binding SelectedWork}">
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn Header="作品名" DisplayMemberBinding="{Binding Title}" Width="200" />
                        <ui:GridViewColumn Header="作者" DisplayMemberBinding="{Binding AuthorsText}" Width="120" />
                        <ui:GridViewColumn Header="社團" DisplayMemberBinding="{Binding CirclesText}" Width="120" />
                        <ui:GridViewColumn Header="類型" DisplayMemberBinding="{Binding WorkType}" Width="60" />
                        <ui:GridViewColumn Header="系列" DisplayMemberBinding="{Binding Series}" Width="100" />
                        <ui:GridViewColumn Header="標籤" DisplayMemberBinding="{Binding TagsText}" Width="120" />
                        <ui:GridViewColumn Header="評分" DisplayMemberBinding="{Binding ScoreText}" Width="70" />
                        <ui:GridViewColumn Header="最愛" DisplayMemberBinding="{Binding Favorite}" Width="50" />
                        <ui:GridViewColumn Header="已購買" DisplayMemberBinding="{Binding Purchased}" Width="60" />
                        <ui:GridViewColumn Header="上架日"
                                           DisplayMemberBinding="{Binding ReleaseDate, StringFormat=yyyy/MM/dd}"
                                           Width="90" />
                        <ui:GridViewColumn Header="修改時間"
                                           DisplayMemberBinding="{Binding UpdatedAtLocal, StringFormat=yyyy/MM/dd HH:mm}"
                                           Width="120" />
                        <ui:GridViewColumn Header="加入時間"
                                           DisplayMemberBinding="{Binding CreatedAtLocal, StringFormat=yyyy/MM/dd HH:mm}"
                                           Width="120" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>