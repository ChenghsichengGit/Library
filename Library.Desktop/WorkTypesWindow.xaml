<Window x:Class="Library.Desktop.WorkTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Library.Desktop"
        mc:Ignorable="d"
        Title="管理類型" Height="450" Width="400">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="名稱" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
            <TextBlock Text="順序 (空白 = 排在「其他」前面)" />
            <TextBox Text="{Binding SortOrderText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="新增" Command="{Binding AddCommand}" Padding="12,4" />
                <Button Content="儲存修改" Command="{Binding SaveCommand}" Padding="12,4" Margin="8,0,0,0" />
                <Button Content="刪除" Command="{Binding DeleteCommand}" Padding="12,4" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding WorkTypes}" SelectedItem="{Binding SelectedType}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="順序" Binding="{Binding SortOrder}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>