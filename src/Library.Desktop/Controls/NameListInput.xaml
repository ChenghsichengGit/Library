<UserControl x:Class="Library.Desktop.Controls.NameListInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Library.Desktop.ViewModels.Parts"
             xmlns:models="clr-namespace:Library.Desktop.Models"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NameListEditor}">
    <!-- DataContext 由使用的地方指定（MainViewModel.Authors 等），這裡的繫結都從 NameListEditor 開始找 -->
    <StackPanel>
        <!-- 已加入的名字：一個個標籤塊，寬度不夠時換行 -->
        <ItemsControl ItemsSource="{Binding Names}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="4" Padding="8,2,2,2" Margin="0,0,4,4">
                        <StackPanel Orientation="Horizontal">
                            <!-- 每一項就是一個字串，{Binding} 是它本身 -->
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <ui:Button Icon="{ui:SymbolIcon Dismiss12}" Appearance="Transparent"
                                       Padding="4" Margin="2,0,0,0" ToolTip="移除"
                                       Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 輸入框：建議清單由 NameListEditor 算好，選了就加入，不把文字填回輸入框 -->
        <ui:AutoSuggestBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ItemsSource="{Binding Suggestions}"
                           UpdateTextOnSelect="False"
                           PlaceholderText="輸入後按 Enter 加入"
                           TextChanged="Box_TextChanged"
                           SuggestionChosen="Box_SuggestionChosen"
                           QuerySubmitted="Box_QuerySubmitted"
                           PreviewKeyDown="Box_PreviewKeyDown">
            <ui:AutoSuggestBox.ItemTemplate>
                <!-- 一個建議：名字在左、作品數在右 -->
                <DataTemplate DataType="{x:Type models:NameOption}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding WorkCount}" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Name}" />
                    </DockPanel>
                </DataTemplate>
            </ui:AutoSuggestBox.ItemTemplate>
        </ui:AutoSuggestBox>
    </StackPanel>
</UserControl>
