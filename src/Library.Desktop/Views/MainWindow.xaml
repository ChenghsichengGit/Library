<ui:FluentWindow x:Class="Library.Desktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:Library.Desktop.ViewModels"
                 xmlns:parts="clr-namespace:Library.Desktop.ViewModels.Parts"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Library.Desktop.Controls"
                 xmlns:models="clr-namespace:Library.Desktop.Models"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DesignMainViewModel, IsDesignTimeCreatable=True}"
                 Title="收藏庫" Height="800" Width="1320"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="收藏庫" />
        <DockPanel Margin="12,4,12,12">
            <!-- 工具列：動作在左，狀態在右 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="新增作品" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                               Command="{Binding NewCommand}" />
                    <ui:Button Content="重新載入" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                               Command="{Binding LoadCommand}" />
                    <ui:Button Content="管理類型" Icon="{ui:SymbolIcon Settings24}" Margin="8,0,0,0"
                               Command="{Binding ManageWorkTypesCommand}" />
                    <ui:Button Content="管理作者／系列" Icon="{ui:SymbolIcon People24}" Margin="8,0,0,0"
                               Command="{Binding ManageCreatorsCommand}" />
                    <ui:Button Content="掃描重複" Icon="{ui:SymbolIcon DocumentSearch24}" Margin="8,0,0,0"
                               Command="{Binding ScanDuplicatesCommand}" />
                    <ui:Button Content="更新價格" Icon="{ui:SymbolIcon Money24}" Margin="8,0,0,0"
                               Command="{Binding RefreshPricesCommand}" />
                    <ui:Button Content="{Binding TrashButtonText}" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0"
                               Command="{Binding OpenTrashCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- 搜尋、篩選、排序；視窗窄時自動換行 -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280"
                            PlaceholderText="搜尋名稱、作者、系列、簡介" Icon="{ui:SymbolIcon Search24}"
                            Margin="0,0,6,4">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Content="搜尋" Command="{Binding LoadCommand}" Margin="0,0,16,4" />

                <ComboBox ItemsSource="{Binding WorkTypeFilters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding FilterWorkTypeId}" Width="130" Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding CreatorFilters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding FilterCreatorId}" Width="160" Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding SeriesFilters}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding FilterSeriesId}" Width="160" Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding ScoreFilters}" SelectedItem="{Binding SelectedScoreFilter}"
                          DisplayMemberPath="Label" Width="130" Margin="0,0,8,4" />
                <CheckBox Content="只看最愛" IsChecked="{Binding OnlyFavorite}" Margin="0,0,16,4" />
                <CheckBox Content="DLC 沒買齊" IsChecked="{Binding DlcUnbought}" Margin="0,0,16,4" />
                <CheckBox Content="特價中" IsChecked="{Binding OnSale}" Margin="0,0,16,4" />

                <!-- 排序的標籤、選單、降冪包成一組，換行時一起移動 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="排序" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              DisplayMemberPath="Label" Width="130" Margin="0,0,8,0" />
                    <CheckBox Content="降冪" IsChecked="{Binding SortDescending}" />
                </StackPanel>
            </WrapPanel>

            <!-- 篩選某位作者／社團時顯示：名稱、網址、備註、取消篩選 -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,4" CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- 沒有篩選（FilterCreator 是 null）時整條隱藏 -->
                            <DataTrigger Binding="{Binding FilterCreator}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                               ToolTip="取消篩選" Command="{Binding ClearCreatorFilterCommand}" />

                    <TextBlock Text="{Binding FilterCreator.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <ui:Button Content="網站" Icon="{ui:SymbolIcon Open24}" Appearance="Transparent" Margin="8,0,0,0"
                               Command="{Binding OpenCreatorUrlCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Style.Triggers>
                                    <!-- 沒填網址就不顯示 -->
                                    <DataTrigger Binding="{Binding FilterCreator.Url}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <!-- 開啟管理視窗並選好這個人 -->
                    <ui:Button Content="編輯" Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" Margin="4,0,0,0"
                               Command="{Binding ManageCreatorsCommand}"
                               CommandParameter="{Binding FilterCreatorId}" />
                    <TextBlock Text="{Binding FilterCreator.Note}" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Opacity="0.7" />
                </DockPanel>
            </Border>

            <!-- 標籤篩選：預設收合，標題顯示已選幾個；標籤多時限制高度、內部捲動，不把表格往下擠 -->
            <Expander DockPanel.Dock="Top" Header="{Binding TagFilterHeader}" Margin="0,0,0,8">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Top" Content="符合任一個即可（不勾：全部都要有）"
                              IsChecked="{Binding TagMatchAny}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type parts:TagFilterOption}">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                              MinWidth="0" Margin="0,0,16,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Expander>

            <!-- 右側：編輯表單。儲存、刪除固定在底部，表單本身比視窗高時可捲動 -->
            <DockPanel x:Name="EditForm" DockPanel.Dock="Right" Width="340" Margin="12,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="儲存" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                                   HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
                        <ui:Button Grid.Column="2" Content="刪除" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                   HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="FormScroll_ScrollChanged">
                    <StackPanel Margin="0,0,12,0">
                        <!-- 從商店抓資料：只填表單，不存檔 -->
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="抓取" Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Margin="6,0,0,0" Command="{Binding FetchCommand}" />
                            <ui:TextBox Text="{Binding StoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="貼上網址">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding FetchCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </DockPanel>

                        <!-- 封面：可拖放圖片到框裡；剪貼簿裡是圖片時按 Ctrl+V 貼上 -->
                        <Border AllowDrop="True" DragOver="CoverArea_DragOver" Drop="CoverArea_Drop"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6" Height="160" Margin="0,10,0,0">
                            <Grid>
                                <!-- 沒有指定 Row、Column，三個元素疊在同一格：預覽、提示、進度圈 -->
                                <Image Source="{Binding CoverPreviewUrl}" Stretch="Uniform" Margin="4" />

                                <!-- 沒有封面時才顯示提示 -->
                                <TextBlock Text="拖放圖片到這裡&#10;或按 Ctrl+V 貼上" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverPreviewUrl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ui:ProgressRing IsIndeterminate="True"
                                                 Visibility="{Binding IsCoverBusy, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <DockPanel Margin="0,4,0,0">
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                       ToolTip="移除封面" Command="{Binding RemoveCoverCommand}" />
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ImageAdd24}"
                                       Appearance="Transparent"
                                       ToolTip="選擇圖片" Command="{Binding PickCoverCommand}" />
                            <TextBlock Text="{Binding CoverStatus}" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- 名稱：用提示文字代替標籤 -->
                        <ui:TextBox Text="{Binding TitleZh, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="中文名稱" Margin="0,8,0,6" />
                        <ui:TextBox Text="{Binding TitleJa, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="日文名稱" Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding TitleEn, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="英文名稱" />
                        <!-- 重複提示：名稱、網址和既有作品重複時出現；完全重複是紅色，可能重複是黃色 -->
                        <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- 預設是黃色（可能重複） -->
                                    <Setter Property="Background"
                                            Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <!-- 沒有重複：標題是空字串，整塊隱藏 -->
                                        <DataTrigger Binding="{Binding DuplicateHeader}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- 完全重複：換成紅色 -->
                                        <DataTrigger Binding="{Binding IsExactDuplicate}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="{Binding DuplicateHeader}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding DuplicateMatches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DuplicateMatch}">
                                            <DockPanel Margin="0,4,0,0">
                                                <!-- 在 ItemTemplate 裡，DataContext 是 DuplicateMatch，命令要往上找 ItemsControl 拿 -->
                                                <ui:Button DockPanel.Dock="Right" Content="看這筆"
                                                           Appearance="Transparent"
                                                           Command="{Binding DataContext.ShowDuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding Id}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Opacity="0.7"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 其他欄位：標籤在左、輸入在右 -->
                        <DockPanel Margin="0,10,0,6">
                            <TextBlock Text="作者" Style="{StaticResource RowLabel}" />
                            <controls:NameListInput DataContext="{Binding Authors}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="社團" Style="{StaticResource RowLabel}" />
                            <controls:NameListInput DataContext="{Binding Circles}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="類型" Style="{StaticResource RowLabel}" />
                            <DatePicker DockPanel.Dock="Right" SelectedDate="{Binding ReleaseDate}" Width="136"
                                        Margin="6,0,0,0" ToolTip="上架日期" />
                            <ComboBox ItemsSource="{Binding WorkTypes}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding WorkTypeId}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="系列" Style="{StaticResource RowLabel}" />
                            <!-- 可直接輸入新系列（存檔時由 API 建立），也可以從建議選；目前作者的系列排前面 -->
                            <ui:AutoSuggestBox
                                Text="{Binding SeriesInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{Binding SeriesSuggestions}"
                                UpdateTextOnSelect="False"
                                TextChanged="SeriesBox_TextChanged"
                                SuggestionChosen="SeriesBox_SuggestionChosen">
                                <ui:AutoSuggestBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SeriesItem}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Margin="12,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ui:AutoSuggestBox.ItemTemplate>
                            </ui:AutoSuggestBox>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="標籤" Style="{StaticResource RowLabel}" />
                            <controls:NameListInput DataContext="{Binding Tags}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="評分" Style="{StaticResource RowLabel}" />
                            <CheckBox DockPanel.Dock="Right" Content="最愛" IsChecked="{Binding Favorite}"
                                      MinWidth="0" Margin="12,0,0,0" />
                            <ComboBox ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Score}"
                                      ToolTip="6 是王冠" />
                        </DockPanel>

                        <TextBlock Text="商店網址" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                        <!-- 每一列的 DataContext 是 UrlRow；選項和命令在 MainViewModel，要經 RelativeSource 往上取 -->
                        <ItemsControl ItemsSource="{Binding Urls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type parts:UrlRow}">
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                                                           Appearance="Transparent" ToolTip="移除這個網址" Margin="4,0,0,0"
                                                           Command="{Binding DataContext.RemoveUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="https://…" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <!-- 清單順序就是存檔的順序，第一個是主要網址 -->
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowDown24}"
                                                           Appearance="Transparent" ToolTip="往下移"
                                                           Command="{Binding DataContext.MoveUrlDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUp24}"
                                                           Appearance="Transparent" ToolTip="往上移"
                                                           Command="{Binding DataContext.MoveUrlUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ComboBox
                                                    ItemsSource="{Binding DataContext.UrlLanguageOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    DisplayMemberPath="Label" SelectedValuePath="Value"
                                                    SelectedValue="{Binding Language}" Width="92" Margin="0,0,10,0" />
                                                <CheckBox Content="已購買" IsChecked="{Binding Purchased}" MinWidth="0" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <ui:TextBox
                                                    Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="價格" Width="84" />
                                                <ui:TextBox
                                                    Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="幣別" Width="64" Margin="6,0,0,0" />
                                                <!-- 有特價時才有文字：原價 NT$268（−50%） -->
                                                <TextBlock Text="{Binding DiscountText}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="新增網址" Icon="{ui:SymbolIcon Add24}" Appearance="Transparent"
                                   HorizontalAlignment="Stretch" Command="{Binding AddUrlCommand}" />

                        <!-- 不常用的區塊預設收起來；標題顯示 DLC 數量 -->
                        <Expander Header="{Binding DlcHeader}" Margin="0,10,0,0">
                            <StackPanel>
                                <!-- 結構同網址卡片；名稱必填，網址可省略，沒有語言 -->
                                <ItemsControl ItemsSource="{Binding Dlcs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type parts:DlcRow}">
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <ui:Button DockPanel.Dock="Right"
                                                                   Icon="{ui:SymbolIcon Dismiss24}"
                                                                   Appearance="Transparent" ToolTip="移除這個 DLC"
                                                                   Margin="4,0,0,0"
                                                                   Command="{Binding DataContext.RemoveDlcCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:TextBox
                                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="名稱" />
                                                    </DockPanel>
                                                    <ui:TextBox
                                                        Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="網址（可省略）" Margin="0,6,0,0" />
                                                    <DockPanel Margin="0,6,0,0">
                                                        <ui:Button DockPanel.Dock="Right"
                                                                   Icon="{ui:SymbolIcon ArrowDown24}"
                                                                   Appearance="Transparent" ToolTip="往下移"
                                                                   Command="{Binding DataContext.MoveDlcDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:Button DockPanel.Dock="Right"
                                                                   Icon="{ui:SymbolIcon ArrowUp24}"
                                                                   Appearance="Transparent" ToolTip="往上移"
                                                                   Command="{Binding DataContext.MoveDlcUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" />
                                                        <ui:TextBox
                                                            Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="價格" Width="84" />
                                                        <ui:TextBox
                                                            Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="幣別" Width="64" Margin="6,0,10,0" />
                                                        <CheckBox Content="已購買" IsChecked="{Binding Purchased}"
                                                                  MinWidth="0" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Content="新增 DLC" Icon="{ui:SymbolIcon Add24}" Appearance="Transparent"
                                           HorizontalAlignment="Stretch" Command="{Binding AddDlcCommand}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="簡介" Margin="0,6,0,0">
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Height="120" TextWrapping="Wrap" AcceptsReturn="True" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- 作品表格放最後，填滿剩下的空間 -->
            <!-- 唯讀清單用 ListView + GridView：DataGrid 每格多好幾層元件，換排序時排版繪製慢一倍以上 -->
            <!-- 要用 ui: 版本：GridView 自己指定樣式，不會套用 App.xaml 的主題 -->
            <ui:ListView ItemsSource="{Binding Works}" SelectedItem="{Binding SelectedWork}">
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn Header="作品名" DisplayMemberBinding="{Binding Title}" Width="220" />
                        <ui:GridViewColumn Header="最愛" DisplayMemberBinding="{Binding FavoriteText}" Width="56" />
                        <ui:GridViewColumn Header="已購買" DisplayMemberBinding="{Binding PurchasedText}" Width="64" />
                        <!-- 有特價時是「原價 → 現價（−折扣%）」；多個網址時取最便宜的（WorkItem.PriceText） -->
                        <ui:GridViewColumn Header="價格" DisplayMemberBinding="{Binding PriceText}" Width="200" />
                        <ui:GridViewColumn Header="類型" DisplayMemberBinding="{Binding WorkType}" Width="64" />
                        <ui:GridViewColumn Header="系列" DisplayMemberBinding="{Binding Series}" Width="100" />
                        <ui:GridViewColumn Header="評分" DisplayMemberBinding="{Binding ScoreText}" Width="80" />
                        <ui:GridViewColumn Header="標籤" DisplayMemberBinding="{Binding TagsText}" Width="120" />
                        <ui:GridViewColumn Header="作者" DisplayMemberBinding="{Binding AuthorsText}" Width="120" />
                        <ui:GridViewColumn Header="社團" DisplayMemberBinding="{Binding CirclesText}" Width="120" />
                        <ui:GridViewColumn Header="上架日"
                                           DisplayMemberBinding="{Binding ReleaseDate, StringFormat=yyyy/MM/dd}"
                                           Width="96" />
                        <ui:GridViewColumn Header="修改時間"
                                           DisplayMemberBinding="{Binding UpdatedAtLocal, StringFormat=yyyy/MM/dd HH:mm}"
                                           Width="130" />
                        <ui:GridViewColumn Header="加入時間"
                                           DisplayMemberBinding="{Binding CreatedAtLocal, StringFormat=yyyy/MM/dd HH:mm}"
                                           Width="130" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>
